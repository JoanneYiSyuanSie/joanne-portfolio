# ==========================================
# 🛑 請在這裡貼上你的 Threads API 資訊 🛑
# ==========================================

# 你的 Threads 長期存取權杖 (Long-lived Access Token)
# 本地開發時，請複製此檔案並重新命名為 .env.local，然後將真實的金鑰填入下方：
THREADS_ACCESS_TOKEN="YOUR_THREADS_ACCESS_TOKEN_HERE"

# 說明與自動續期指南：
# 1. 本地端測試時，系統會讀取這個 .env.local 檔案。
# 2. 此檔案 (.env.local) 已設定在 .gitignore 中，不會被上傳到公開的 GitHub，請放心。
# 3. 部署到 Cloudflare Pages 時，可在控制台 Settings -> Environment variables 設定初始 THREADS_ACCESS_TOKEN。
#
# 🤖 推薦全自動續期設定（一勞永逸，不用再手動每 2 個月更新）：
#    a. 在 Cloudflare Dashboard -> Storage & Databases -> KV 建立一個 KV Namespace (如: THREADS_KV)。
#    b. 前往 Cloudflare Pages 專案 -> Settings -> Functions -> KV namespace bindings。
#    c. 新增綁定 Variable name: `THREADS_KV`，選擇剛剛建立的 KV Namespace。
#    d. 部署專案。以後每當有訪客瀏覽，系統會自動在背景向 Meta 續期 Token 並更新儲存至 KV，永不到期！
#

# ==========================================
# 🛑 請在這裡貼上你的 Notion 與 Discord 資訊 🛑
# ==========================================
NOTION_TOKEN="YOUR_NOTION_TOKEN_HERE"
NOTION_DATABASE_ID="YOUR_NOTION_DATABASE_ID_HERE"
DISCORD_WEBHOOK_URL="YOUR_DISCORD_WEBHOOK_URL_HERE"
