# Default for HTML pages and dynamic routes:
# Always revalidate so when a new deploy goes live, visitors see changes instantly
/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets generated by Astro/Vite:
# These files have content hashes (e.g. style.abc123.css) so they are safe to cache for 1 year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
